  "keywords": ["presentation", "slides", "html", "presenter-view", "speaker-notes", "claude-code", "skill", "hdek"],
  "homepage": "https://github.com/grotyx/deckwright",
  "repository": { "type": "git", "url": "git+https://github.com/grotyx/deckwright.git" },
  "bugs": { "url": "https://github.com/grotyx/deckwright/issues" },
  "author": "Sang-Min Park",
  "license": "MIT",
  "bin": {
    "deckwright": "skills/deckwright/scripts/deckwright.mjs",
    "hdek": "skills/deckwright/scripts/deckwright.mjs"
  },
  "files": ["skills", "SPEC.md", "SPEC.ko.md", "README.md", "README.ko.md", "CHANGELOG.md", "CHANGELOG.ko.md", "LICENSE"],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && python3 test/run_tests.py"
  },
